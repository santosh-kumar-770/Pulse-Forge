# ==========================================
# PulseForge Monorepo .gitignore
# ==========================================

# Operating System & Editors
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-workspace
*.sublime-project

# Environment & Secret Configurations
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Python & Backend (FastAPI / SQLAlchemy)
# ==========================================
api/.venv/
api/venv/
api/env/
.venv/
venv/
env/
ENV/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# SQLite Database & Storage
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
pulseforge.db
api/pulseforge.db

# ==========================================
# Node.js & Frontend (Vite / React)
# ==========================================
frontend/node_modules/
node_modules/

# Production Build Output
# frontend/dist/ (allowed for Vercel deployment)
dist/
build/
.vite/

# Testing & Coverage
coverage/
.nyc_output/

# Temporary / Scratch Files
scratch/
tmp/
temp/

.vercel
