# Application Identity
APP_NAME=PulseForge

# Database Connection (Neon PostgreSQL recommended for production; SQLite for local dev)
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-patient-math-a1a1cj3n-pooler.ap-southeast-1.aws.neon.tech/neondb?ssl=require
# Or for local SQLite:
