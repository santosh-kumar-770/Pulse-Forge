{
  "framework": null,
  "outputDirectory": "frontend/dist",
  "crons": [
    {
      "path": "/api/cron/check-deadlines",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
